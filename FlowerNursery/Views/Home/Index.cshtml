@model IEnumerable<FlowerNursery.Models.WateringSchedule>
@{
    ViewData["Title"] = "Dashboard";
    var overdueWaterings = ViewBag.OverdueWaterings as IEnumerable<FlowerNursery.Models.WateringSchedule>;
}

<div class="row mb-4">
    <div class="col">
        <h1 class="display-5 fw-bold text-success">
            <i class="bi bi-flower1 me-2"></i>Nursery Dashboard
        </h1>
        <p class="text-muted">Overview of your flower nursery</p>
    </div>
</div>

<!-- Stats cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-success bg-opacity-10 p-3">
                    <i class="bi bi-building text-success fs-3"></i>
                </div>
                <div>
                    <div class="fs-2 fw-bold text-success">@ViewBag.GreenhouseCount</div>
                    <div class="text-muted small">Greenhouses</div>
                </div>
                <a asp-controller="Greenhouses" asp-action="Index" class="stretched-link"></a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                    <i class="bi bi-flower2 text-primary fs-3"></i>
                </div>
                <div>
                    <div class="fs-2 fw-bold text-primary">@ViewBag.FlowerGroupCount</div>
                    <div class="text-muted small">Flower Groups</div>
                </div>
                <a asp-controller="FlowerGroups" asp-action="Index" class="stretched-link"></a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-info bg-opacity-10 p-3">
                    <i class="bi bi-droplet text-info fs-3"></i>
                </div>
                <div>
                    <div class="fs-2 fw-bold text-info">@ViewBag.PendingCount</div>
                    <div class="text-muted small">Pending Waterings</div>
                </div>
                <a asp-controller="WateringSchedules" asp-action="Index" class="stretched-link"></a>
            </div>
        </div>
    </div>
</div>

<!-- Overdue tasks -->
@if (overdueWaterings != null && overdueWaterings.Any())
{
    <div class="card border-danger mb-4">
        <div class="card-header bg-danger text-white">
            <i class="bi bi-exclamation-triangle me-2"></i>Overdue Watering Tasks
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Flower Group</th>
                        <th>Greenhouse</th>
                        <th>Scheduled Date</th>
                        <th>Days Overdue</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ws in overdueWaterings)
                    {
                        <tr>
                            <td>@ws.FlowerGroup?.Species</td>
                            <td>@ws.FlowerGroup?.Greenhouse?.Name</td>
                            <td>@ws.ScheduledDate.ToString("dd MMM yyyy")</td>
                            <td><span class="badge bg-danger">@((DateTime.Today - ws.ScheduledDate.Date).Days) days</span></td>
                            <td>
                                <form asp-action="MarkComplete" asp-controller="WateringSchedules" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@ws.Id" />
                                    <input type="hidden" name="returnUrl" value="/" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success">
                                        <i class="bi bi-check2 me-1"></i>Mark Done
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Upcoming tasks -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-calendar-check me-2 text-success"></i>Upcoming Watering Tasks</h5>
            <a asp-controller="WateringSchedules" asp-action="Create" class="btn btn-sm btn-outline-success">
                <i class="bi bi-plus me-1"></i>Add Task
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-droplet fs-1 d-block mb-2"></i>
                <p>No upcoming watering tasks.</p>
                <a asp-controller="WateringSchedules" asp-action="Create" class="btn btn-success">
                    <i class="bi bi-plus me-1"></i>Schedule a Watering
                </a>
            </div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Flower Group</th>
                        <th>Greenhouse</th>
                        <th>Scheduled Date</th>
                        <th>Notes</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ws in Model)
                    {
                        var isToday = ws.ScheduledDate.Date == DateTime.Today;
                        <tr class="@(isToday ? "table-warning" : "")">
                            <td>
                                <strong>@ws.FlowerGroup?.Species</strong>
                                @if (ws.FlowerGroup?.Color != null)
                                {
                                    <span class="badge bg-secondary ms-1">@ws.FlowerGroup.Color</span>
                                }
                            </td>
                            <td>@ws.FlowerGroup?.Greenhouse?.Name</td>
                            <td>
                                @ws.ScheduledDate.ToString("dd MMM yyyy")
                                @if (isToday)
                                {
                                    <span class="badge bg-warning text-dark ms-1">Today</span>
                                }
                            </td>
                            <td class="text-muted small">@ws.Notes</td>
                            <td>
                                <form asp-action="MarkComplete" asp-controller="WateringSchedules" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@ws.Id" />
                                    <input type="hidden" name="returnUrl" value="/" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success">
                                        <i class="bi bi-check2 me-1"></i>Done
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
