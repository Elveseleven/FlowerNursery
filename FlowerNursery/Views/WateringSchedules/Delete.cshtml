@model FlowerNursery.Models.WateringSchedule
@{
    ViewData["Title"] = "Delete Watering Task";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-trash me-2"></i>Delete Watering Task</h4>
            </div>
            <div class="card-body p-4">
                <p>Are you sure you want to delete this watering task?</p>

                <dl class="row">
                    <dt class="col-sm-5">Flower Group</dt>
                    <dd class="col-sm-7">@Model.FlowerGroup?.Species</dd>
                    <dt class="col-sm-5">Greenhouse</dt>
                    <dd class="col-sm-7">@Model.FlowerGroup?.Greenhouse?.Name</dd>
                    <dt class="col-sm-5">Scheduled Date</dt>
                    <dd class="col-sm-7">@Model.ScheduledDate.ToString("dd MMM yyyy")</dd>
                    <dt class="col-sm-5">Status</dt>
                    <dd class="col-sm-7">@(Model.IsCompleted ? "Completed" : "Pending")</dd>
                </dl>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger flex-fill">
                            <i class="bi bi-trash me-1"></i>Yes, Delete
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary flex-fill">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
