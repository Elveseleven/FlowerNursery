@model IEnumerable<FlowerNursery.Models.WateringSchedule>
@{
    var rowClass = ViewData["rowClass"] as string ?? "";
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Flower Group</th>
                    <th>Greenhouse</th>
                    <th>Scheduled Date</th>
                    <th>Notes</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ws in Model)
                {
                    <tr class="@rowClass">
                        <td>
                            <a asp-controller="FlowerGroups" asp-action="Details" asp-route-id="@ws.FlowerGroupId" class="text-decoration-none fw-semibold">
                                @ws.FlowerGroup?.Species
                            </a>
                        </td>
                        <td>@ws.FlowerGroup?.Greenhouse?.Name</td>
                        <td>@ws.ScheduledDate.ToString("dd MMM yyyy")</td>
                        <td class="text-muted small">@ws.Notes</td>
                        <td>
                            <div class="d-flex gap-1">
                                <form asp-action="MarkComplete" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@ws.Id" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success" title="Mark as done">
                                        <i class="bi bi-check2"></i>
                                    </button>
                                </form>
                                <a asp-action="Edit" asp-route-id="@ws.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@ws.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
