@model FlowerNursery.Models.FlowerGroup
@{
    ViewData["Title"] = Model.Species;
    var pendingWaterings = Model.WateringSchedules.Where(ws => !ws.IsCompleted).OrderBy(ws => ws.ScheduledDate).ToList();
    var completedWaterings = Model.WateringSchedules.Where(ws => ws.IsCompleted).OrderByDescending(ws => ws.CompletedDate).Take(5).ToList();
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h2">
            <i class="bi bi-flower2 me-2 text-primary"></i>@Model.Species
            @if (!string.IsNullOrEmpty(Model.Color))
            {
                <span class="badge bg-secondary fs-6">@Model.Color</span>
            }
        </h1>
        <p class="text-muted">
            <i class="bi bi-building me-1"></i>@Model.Greenhouse?.Name &nbsp;&nbsp;
            <i class="bi bi-hash me-1"></i>@Model.Quantity plants
        </p>
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <p>@Model.Notes</p>
        }
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <a asp-controller="WateringSchedules" asp-action="Create" asp-route-flowerGroupId="@Model.Id" class="btn btn-outline-info">
            <i class="bi bi-droplet me-1"></i>Schedule Watering
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-droplet me-2 text-info"></i>Upcoming Waterings</h5>
            </div>
            <div class="card-body p-0">
                @if (!pendingWaterings.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <p class="mb-1">No upcoming waterings scheduled.</p>
                        <a asp-controller="WateringSchedules" asp-action="Create" asp-route-flowerGroupId="@Model.Id" class="btn btn-sm btn-outline-info">Schedule</a>
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var ws in pendingWaterings)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>
                                    @ws.ScheduledDate.ToString("dd MMM yyyy")
                                    @if (ws.ScheduledDate.Date < DateTime.Today)
                                    {
                                        <span class="badge bg-danger ms-1">Overdue</span>
                                    }
                                    else if (ws.ScheduledDate.Date == DateTime.Today)
                                    {
                                        <span class="badge bg-warning text-dark ms-1">Today</span>
                                    }
                                </span>
                                <form asp-controller="WateringSchedules" asp-action="MarkComplete" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@ws.Id" />
                                    <input type="hidden" name="returnUrl" value="/FlowerGroups/Details/@Model.Id" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success">
                                        <i class="bi bi-check2"></i>
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-clock-history me-2 text-secondary"></i>Recent Watering History</h5>
                <a asp-controller="WateringSchedules" asp-action="History" asp-route-flowerGroupId="@Model.Id" class="btn btn-sm btn-outline-secondary">
                    View All
                </a>
            </div>
            <div class="card-body p-0">
                @if (!completedWaterings.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <p>No completed waterings yet.</p>
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var ws in completedWaterings)
                        {
                            <li class="list-group-item">
                                <i class="bi bi-check-circle-fill text-success me-2"></i>
                                Completed on @ws.CompletedDate?.ToString("dd MMM yyyy")
                                <small class="text-muted d-block ms-4">Scheduled: @ws.ScheduledDate.ToString("dd MMM yyyy")</small>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
