@model FlowerNursery.Models.FlowerGroup
@{
    ViewData["Title"] = "Edit Flower Group";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Flower Group</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="GreenhouseId" class="form-label fw-semibold"></label>
                        <select asp-for="GreenhouseId" asp-items="ViewBag.GreenhouseId" class="form-select"></select>
                        <span asp-validation-for="GreenhouseId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Species" class="form-label fw-semibold"></label>
                        <input asp-for="Species" class="form-control" />
                        <span asp-validation-for="Species" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Color" class="form-label fw-semibold"></label>
                        <input asp-for="Color" class="form-control" />
                        <span asp-validation-for="Color" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Quantity" class="form-label fw-semibold"></label>
                        <input asp-for="Quantity" class="form-control" type="number" min="1" />
                        <span asp-validation-for="Quantity" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label fw-semibold"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">
                            <i class="bi bi-save me-1"></i>Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary flex-fill">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
