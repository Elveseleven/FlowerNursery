@model IEnumerable<FlowerNursery.Models.Greenhouse>
@{
    ViewData["Title"] = "Greenhouses";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2"><i class="bi bi-building me-2 text-success"></i>Greenhouses</h1>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-lg me-1"></i>Add Greenhouse
    </a>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-building fs-1 d-block mb-2"></i>
        <p>No greenhouses yet.</p>
        <a asp-action="Create" class="btn btn-success">Add your first greenhouse</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var greenhouse in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-building me-2"></i>@greenhouse.Name
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(greenhouse.Location))
                        {
                            <p class="mb-1 text-muted small">
                                <i class="bi bi-geo-alt me-1"></i>@greenhouse.Location
                            </p>
                        }
                        @if (!string.IsNullOrEmpty(greenhouse.Notes))
                        {
                            <p class="mb-2 small">@greenhouse.Notes</p>
                        }
                        <div class="d-flex align-items-center">
                            <span class="badge bg-primary rounded-pill">
                                <i class="bi bi-flower2 me-1"></i>@greenhouse.FlowerGroups.Count flower group(s)
                            </span>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@greenhouse.Id" class="btn btn-sm btn-outline-secondary flex-fill">
                            <i class="bi bi-eye me-1"></i>Details
                        </a>
                        <a asp-action="Edit" asp-route-id="@greenhouse.Id" class="btn btn-sm btn-outline-primary flex-fill">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@greenhouse.Id" class="btn btn-sm btn-outline-danger flex-fill">
                            <i class="bi bi-trash me-1"></i>Delete
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
