@model FlowerNursery.Models.Greenhouse
@{
    ViewData["Title"] = Model.Name;
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h2"><i class="bi bi-building me-2 text-success"></i>@Model.Name</h1>
        @if (!string.IsNullOrEmpty(Model.Location))
        {
            <p class="text-muted"><i class="bi bi-geo-alt me-1"></i>@Model.Location</p>
        }
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <p>@Model.Notes</p>
        }
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-flower2 me-2 text-primary"></i>Flower Groups in this Greenhouse</h5>
        <a asp-controller="FlowerGroups" asp-action="Create" class="btn btn-sm btn-outline-success">
            <i class="bi bi-plus me-1"></i>Add Flower Group
        </a>
    </div>
    <div class="card-body p-0">
        @if (!Model.FlowerGroups.Any())
        {
            <div class="text-center py-4 text-muted">
                <p>No flower groups assigned to this greenhouse yet.</p>
                <a asp-controller="FlowerGroups" asp-action="Create" class="btn btn-success btn-sm">Add Flower Group</a>
            </div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Species / Variety</th>
                        <th>Color</th>
                        <th>Quantity</th>
                        <th>Scheduled Waterings</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fg in Model.FlowerGroups)
                    {
                        <tr>
                            <td><strong>@fg.Species</strong></td>
                            <td>@fg.Color</td>
                            <td>@fg.Quantity</td>
                            <td>
                                <span class="badge bg-info">@fg.WateringSchedules.Count(ws => !ws.IsCompleted) pending</span>
                            </td>
                            <td>
                                <a asp-controller="FlowerGroups" asp-action="Details" asp-route-id="@fg.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye me-1"></i>Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
